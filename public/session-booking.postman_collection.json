{
  "info": {
    "name": "Session Booking API",
    "description": "Run requests in order. IDs and timestamps are populated automatically. UTC date filtering uses Unix milliseconds. No authentication is required for this assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacherId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "startTime",
      "value": "",
      "type": "string"
    },
    {
      "key": "endTime",
      "value": "",
      "type": "string"
    },
    {
      "key": "dateTimestamp",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 · Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Alex Morgan\",\n  \"email\": \"alex.{{runId}}@example.com\",\n  \"phone\": \"+919876543210\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', Date.now() + '-' + Math.random().toString(36).slice(2));",
              "const start = new Date(Date.now() + 86400000); start.setUTCHours(10, 0, 0, 0);",
              "pm.collectionVariables.set('startTime', start.toISOString());",
              "pm.collectionVariables.set('endTime', new Date(start.getTime() + 3600000).toISOString());",
              "pm.collectionVariables.set('dateTimestamp', String(start.getTime()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) pm.collectionVariables.set('userId', pm.response.json().data._id);"
            ]
          }
        }
      ]
    },
