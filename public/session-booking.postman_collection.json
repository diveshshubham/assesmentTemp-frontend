        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Created session is available', function () { pm.expect(pm.response.json().data.some(s => s._id === pm.collectionVariables.get('sessionId'))).to.be.true; });"
            ]
          }
        }
      ]
    },
